# Nusxa oling: cp .env.example .env
ZAKUP_ENV=local
ZAKUP_DEBUG=true
# localhost emas: Windows avval IPv6 ga urinadi va har ulanishda ~2s yo'qotadi
ZAKUP_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/zakup
# BotFather'dan; local'da bo'sh bo'lishi mumkin
ZAKUP_TELEGRAM_BOT_TOKEN=
ZAKUP_DEV_AUTH_BYPASS=true
# Birinchi kirishda avtomatik admin bo'ladigan Telegram ID(lar), JSON: [123456789]
ZAKUP_BOOTSTRAP_ADMIN_IDS=[]
# Production: kamida 32 belgi (python -c "import secrets; print(secrets.token_urlsafe(48))")
# ZAKUP_JWT_SECRET=
